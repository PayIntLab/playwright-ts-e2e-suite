{
  "name": "playwright-ts-e2e-suite",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright + TypeScript end-to-end test suite for UI, API, CI, and Docker",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --grep @ui",
    "test:headed": "playwright test --headed",
    "test:ui-mode": "playwright test --ui",
    "test:shard": "playwright test --shard=${SHARD:-1/2}",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
